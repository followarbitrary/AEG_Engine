namespace aeg.asset.fb;

enum AssetKind : ubyte {
    Mesh,
    Texture,
    Material,
    Scene,
    Font,
    Pipeline,
    Shader
}

table AssetReference {
    id:[ubyte] (required);
}

table CookedAsset {
    id:[ubyte] (required);
    kind:AssetKind;
    schema_version:uint;
    runtime_dependencies:[AssetReference];
    payload:[ubyte] (required);
}

root_type CookedAsset;
file_identifier "AEGC";
