cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED PROBE OR NOT EXISTS "${PROBE}" OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "FeatureGraph interrupted-save probe requires its built executable and output root")
endif()
get_filename_component(TEST_ROOT "${TEST_ROOT}" ABSOLUTE)
get_filename_component(root_name "${TEST_ROOT}" NAME)
if(NOT root_name STREQUAL "feature-graph-source-crash")
    message(FATAL_ERROR "Unexpected interrupted-save output root")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
foreach(stage after-source-temp-flush after-backup-temp-flush)
    execute_process(COMMAND "${PROBE}" --prepare-crash-probe "${TEST_ROOT}" "${stage}"
        RESULT_VARIABLE prepared OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${prepared}" STREQUAL "0")
        message(FATAL_ERROR "Could not prepare complete author versions: ${prepared}\n${output}\n${error}")
    endif()
    execute_process(COMMAND "${PROBE}" --crash-probe "${TEST_ROOT}" "${stage}"
        RESULT_VARIABLE interrupted OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(stage STREQUAL "after-source-temp-flush")
        set(expected_exit 71)
    else()
        set(expected_exit 72)
    endif()
    if(NOT "${interrupted}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Writer did not terminate at ${stage}: ${interrupted}\n${output}\n${error}")
    endif()
    execute_process(COMMAND "${PROBE}" --verify-crash-probe "${TEST_ROOT}" "${stage}"
        RESULT_VARIABLE verified OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${TEST_ROOT}/${stage}.log" "interrupted=${interrupted}\n${output}\n${error}")
    if(NOT "${verified}" STREQUAL "0" OR NOT output MATCHES "SOURCE_CRASH_RECOVERY_COMPLETE ${stage}")
        message(FATAL_ERROR "Interrupted save lost source/backup or held a dead writer lock: ${verified}\n${output}\n${error}")
    endif()
    message(STATUS "${output}")
endforeach()
