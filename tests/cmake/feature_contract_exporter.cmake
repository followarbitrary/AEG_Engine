cmake_minimum_required(VERSION 3.25)
foreach(required ENGINE_DIR TEST_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Contract exporter smoke requires ${required}")
    endif()
endforeach()
get_filename_component(ENGINE_DIR "${ENGINE_DIR}" ABSOLUTE)
get_filename_component(TEST_ROOT "${TEST_ROOT}" ABSOLUTE)
get_filename_component(test_name "${TEST_ROOT}" NAME)
if(NOT test_name STREQUAL "feature-contract-exporter")
    message(FATAL_ERROR "Unexpected contract exporter fixture root: ${TEST_ROOT}")
endif()
# Only this explicitly named generated test tree belongs to this script.
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(PROJECT_ROOT "${TEST_ROOT}/Source Project")
set(BUILD_ROOT "${TEST_ROOT}/Build")
file(COPY "${ENGINE_DIR}/tests/fixtures/contract_exporter/" DESTINATION "${PROJECT_ROOT}")
set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "4")

function(run_logged label)
    execute_process(COMMAND ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 420)
    file(WRITE "${TEST_ROOT}/${label}.log" "${output}\n${error}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${result}):\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

set(generator_options)
if(DEFINED GENERATOR AND NOT GENERATOR STREQUAL "")
    list(APPEND generator_options -G "${GENERATOR}")
endif()
if(DEFINED GENERATOR_PLATFORM AND NOT GENERATOR_PLATFORM STREQUAL "")
    list(APPEND generator_options -A "${GENERATOR_PLATFORM}")
endif()
if(DEFINED GENERATOR_TOOLSET AND NOT GENERATOR_TOOLSET STREQUAL "")
    list(APPEND generator_options -T "${GENERATOR_TOOLSET}")
endif()
run_logged(configure "${CMAKE_COMMAND}" -S "${PROJECT_ROOT}" -B "${BUILD_ROOT}" ${generator_options}
    "-DENGINE_DIR=${ENGINE_DIR}" -DCMAKE_BUILD_TYPE=Debug)
set(callback_marker "${TEST_ROOT}/exporter-executed-a-feature-callback.txt")
set(ENV{AEG_CONTRACT_EXPORT_CALLBACK_MARKER} "${callback_marker}")
run_logged(build-v1 "${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Debug
    --target ContractExporterFixture ContractExporterFixtureVerifier --parallel 4)
unset(ENV{AEG_CONTRACT_EXPORT_CALLBACK_MARKER})
if(EXISTS "${callback_marker}")
    message(FATAL_ERROR "The host contract exporter executed a Feature callback")
endif()

function(find_executable output name base)
    foreach(candidate "${base}/Debug/${name}.exe" "${base}/${name}.exe" "${base}/${name}")
        if(EXISTS "${candidate}")
            set(${output} "${candidate}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Cold build did not produce ${name} below ${base}")
endfunction()
find_executable(VERIFIER ContractExporterFixtureVerifier "${BUILD_ROOT}")
find_executable(METADATA_TOOL aeg_module_metadata_tool "${BUILD_ROOT}/aeg-engine")
find_executable(EXPORTER ContractExporterFixture_contract_exporter "${BUILD_ROOT}")
set(BUNDLE "${BUILD_ROOT}/ModuleBundle/Debug")
set(MANIFEST "${BUNDLE}/module.manifest.json")
set(SOURCE_METADATA "${BUILD_ROOT}/generated/module-contracts/ContractExporterFixture/Debug/module.source.metadata.json")
if(NOT EXISTS "${SOURCE_METADATA}")
    message(FATAL_ERROR "The host exporter did not produce canonical source metadata")
endif()
if(EXISTS "${PROJECT_ROOT}/Source/GameModule.metadata.json")
    message(FATAL_ERROR "The fixture unexpectedly depends on hand-authored metadata")
endif()

function(verify_bundle revision label)
    run_logged("${label}" "${VERIFIER}" verify "${MANIFEST}" "${revision}")
    if(NOT last_output MATCHES "CONTRACT_EXPORTER_BUNDLE_COMPLETE revision=${revision} callback-commits=1")
        message(FATAL_ERROR "${label} did not execute and commit the actual DLL revision")
    endif()
endfunction()
verify_bundle(1 verify-v1)
file(READ "${MANIFEST}" manifest_v1)
string(JSON metadata_name_v1 GET "${manifest_v1}" metadata_path)
string(JSON contract_v1 GET "${manifest_v1}" contract_digest)
file(COPY_FILE "${BUNDLE}/${metadata_name_v1}" "${TEST_ROOT}/v1.metadata.json")
file(SHA256 "${SOURCE_METADATA}" source_metadata_sha_v1)

# Edit only a shared C++ declaration. There is no JSON edit or regeneration
# command in this path; building the module must rerun its actual host exporter.
set(revision_file "${PROJECT_ROOT}/Source/Revision.hpp")
file(READ "${revision_file}" revision_source)
string(REPLACE "kRevision = 1;" "kRevision = 2;" revision_v2 "${revision_source}")
if(revision_source STREQUAL revision_v2)
    message(FATAL_ERROR "The C++-only revision edit did not change its declared fixture input")
endif()
file(WRITE "${revision_file}" "${revision_v2}")
set(ENV{AEG_CONTRACT_EXPORT_CALLBACK_MARKER} "${callback_marker}")
run_logged(build-v2 "${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Debug
    --target ContractExporterFixture --parallel 4)
unset(ENV{AEG_CONTRACT_EXPORT_CALLBACK_MARKER})
if(EXISTS "${callback_marker}")
    message(FATAL_ERROR "The revised host exporter executed a Feature callback")
endif()
verify_bundle(2 verify-v2)
file(READ "${MANIFEST}" manifest_v2)
string(JSON binary_name_v2 GET "${manifest_v2}" binary_path)
string(JSON metadata_name_v2 GET "${manifest_v2}" metadata_path)
string(JSON contract_v2 GET "${manifest_v2}" contract_digest)
file(SHA256 "${SOURCE_METADATA}" source_metadata_sha_v2)
if(contract_v1 STREQUAL contract_v2 OR source_metadata_sha_v1 STREQUAL source_metadata_sha_v2)
    message(FATAL_ERROR "A C++-only contract change reused the old source metadata/digest")
endif()

# The official publication tool makes a self-consistent manifest containing the
# current DLL and old valid metadata. Hash validation must succeed before the
# actual DLL contract comparison rejects it; an accidentally corrupt bundle
# cannot satisfy this negative oracle.
set(MISMATCH "${TEST_ROOT}/StaleMetadataBundle")
file(MAKE_DIRECTORY "${MISMATCH}")
get_filename_component(binary_leaf "${binary_name_v2}" NAME)
file(COPY_FILE "${BUNDLE}/${binary_name_v2}" "${MISMATCH}/${binary_leaf}")
run_logged(publish-mismatch "${METADATA_TOOL}" --module "${MISMATCH}/${binary_leaf}"
    --metadata "${TEST_ROOT}/v1.metadata.json" --output "${MISMATCH}/module.metadata.json"
    --manifest "${MISMATCH}/module.manifest.json" --build-id contract-exporter-fixture
    --target windows-x64-vulkan --config Debug)
run_logged(verify-mismatch "${VERIFIER}" reject-contract "${MISMATCH}/module.manifest.json" 2)
if(NOT last_output MATCHES "CONTRACT_EXPORTER_MISMATCH_REJECTED")
    message(FATAL_ERROR "The actual stale-contract DLL rejection oracle did not run")
endif()

# A valid C++ factory can reject its own declarations. That typed failure must
# fail the build before publication and retain the already usable v2 bundle.
file(SHA256 "${MANIFEST}" good_manifest_sha)
file(SHA256 "${BUNDLE}/${metadata_name_v2}" good_metadata_sha)
file(SHA256 "${BUNDLE}/${binary_name_v2}" good_binary_sha)
file(SHA256 "${SOURCE_METADATA}" good_source_metadata_sha)
string(REPLACE "kRejectFactory = false;" "kRejectFactory = true;" rejected_source "${revision_v2}")
if(rejected_source STREQUAL revision_v2)
    message(FATAL_ERROR "The typed factory failure fixture was not armed")
endif()
file(WRITE "${revision_file}" "${rejected_source}")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Debug
        --target ContractExporterFixture --parallel 4
    RESULT_VARIABLE rejected OUTPUT_VARIABLE rejected_output ERROR_VARIABLE rejected_error TIMEOUT 420)
file(WRITE "${TEST_ROOT}/factory-rejection.log" "${rejected_output}\n${rejected_error}")
if("${rejected}" STREQUAL "0" OR
   NOT "${rejected_output}\n${rejected_error}" MATCHES "intentional contract factory rejection")
    message(FATAL_ERROR "The native typed factory rejection did not fail module publication")
endif()
file(SHA256 "${MANIFEST}" retained_manifest_sha)
file(SHA256 "${BUNDLE}/${metadata_name_v2}" retained_metadata_sha)
file(SHA256 "${BUNDLE}/${binary_name_v2}" retained_binary_sha)
file(SHA256 "${SOURCE_METADATA}" retained_source_metadata_sha)
if(NOT good_manifest_sha STREQUAL retained_manifest_sha OR NOT good_metadata_sha STREQUAL retained_metadata_sha OR
   NOT good_binary_sha STREQUAL retained_binary_sha OR NOT good_source_metadata_sha STREQUAL retained_source_metadata_sha)
    message(FATAL_ERROR "A failed host export replaced a last-good source metadata/DLL/manifest artifact")
endif()
verify_bundle(2 verify-last-good)
message(STATUS "CONTRACT_EXPORTER_COLD_COMPLETE: shared C++ factory, two real DLL revisions, stale-contract rejection and retained last-good bundle")
