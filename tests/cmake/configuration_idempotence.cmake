cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ENGINE_DIR OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Configuration idempotence check requires ENGINE_DIR and TEST_ROOT")
endif()
get_filename_component(TEST_ROOT "${TEST_ROOT}" ABSOLUTE)
get_filename_component(root_name "${TEST_ROOT}" NAME)
if(NOT root_name STREQUAL "configuration-idempotence")
    message(FATAL_ERROR "Unexpected configuration idempotence output root")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/Source")
file(WRITE "${TEST_ROOT}/Source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(AegConfigurationIdempotence LANGUAGES CXX)
set(AEG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(AEG_BUILD_EDITOR OFF CACHE BOOL "" FORCE)
set(AEG_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
include("${ENGINE_DIR}/cmake/EngineTools.cmake")
]=])
set(generator_args)
if(DEFINED GENERATOR AND NOT GENERATOR STREQUAL "")
    list(APPEND generator_args -G "${GENERATOR}")
endif()
if(DEFINED GENERATOR_PLATFORM AND NOT GENERATOR_PLATFORM STREQUAL "")
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(DEFINED GENERATOR_TOOLSET AND NOT GENERATOR_TOOLSET STREQUAL "")
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
foreach(pass RANGE 1 2)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/Source" -B "${TEST_ROOT}/Build"
        ${generator_args} "-DENGINE_DIR=${ENGINE_DIR}" -DCMAKE_BUILD_TYPE=Debug
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
    file(WRITE "${TEST_ROOT}/configure-${pass}.log" "${output}\n${error}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Configuration ${pass} failed: ${result}\n${output}\n${error}")
    endif()
    file(STRINGS "${TEST_ROOT}/Build/CMakeCache.txt" flags_${pass}
        REGEX "^CMAKE_CXX_FLAGS_DEBUG:STRING=")
endforeach()
if(NOT flags_1 STREQUAL flags_2)
    message(FATAL_ERROR "CMAKE_CONFIGURATION_IS_NOT_IDEMPOTENT: repeated configure changed compiler flags\n${flags_1}\n${flags_2}")
endif()
message(STATUS "Repeated native configuration kept compiler flags unchanged")
