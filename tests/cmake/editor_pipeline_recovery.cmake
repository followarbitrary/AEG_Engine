cmake_minimum_required(VERSION 3.25)

if (NOT DEFINED EDITOR OR NOT DEFINED FIXTURE_WRITER OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "EDITOR, FIXTURE_WRITER and TEST_ROOT are required")
endif()
get_filename_component(test_root_absolute "${TEST_ROOT}" ABSOLUTE)
get_filename_component(test_root_name "${test_root_absolute}" NAME)
if (NOT test_root_name STREQUAL "editor-pipeline-recovery")
    message(FATAL_ERROR "Refusing to reset an unexpected fixture directory")
endif()
file(REMOVE_RECURSE "${test_root_absolute}")
file(MAKE_DIRECTORY "${test_root_absolute}")
set(ENV{APPDATA} "${test_root_absolute}")
execute_process(COMMAND "${FIXTURE_WRITER}" --startup-recovery-fixture "${test_root_absolute}"
    RESULT_VARIABLE fixture_result OUTPUT_VARIABLE fixture_output ERROR_VARIABLE fixture_error TIMEOUT 30)
if (NOT fixture_result EQUAL 0)
    message(FATAL_ERROR "Recovery fixture failed: ${fixture_output}\n${fixture_error}")
endif()

set(project "${test_root_absolute}/Project/Project.aegproj")
set(pipeline "${test_root_absolute}/Project/Assets/Forward.aegpipe")
file(SHA256 "${project}" project_hash)
foreach(failure IN ITEMS missing_present malformed missing_file)
    if (failure STREQUAL "malformed")
        file(WRITE "${pipeline}" "pipeline_nodes = [invalid TOML")
    elseif (failure STREQUAL "missing_file")
        file(REMOVE "${pipeline}")
    endif()
    if (EXISTS "${pipeline}")
        file(SHA256 "${pipeline}" pipeline_hash)
    endif()
    execute_process(COMMAND "${EDITOR}" --project "${project}" --frames 60 --stress-native-viewports
        WORKING_DIRECTORY "${test_root_absolute}"
        RESULT_VARIABLE run_result OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error TIMEOUT 30)
    set(run_log "${run_output}\n${run_error}")
    if (NOT run_result EQUAL 0 OR run_log MATCHES "Application +ERROR|Application +FATAL" OR
        NOT run_log MATCHES "Application +WARNING")
        message(FATAL_ERROR "Editor failed recovery for ${failure}: ${run_log}")
    endif()
    file(SHA256 "${project}" project_after)
    if (NOT project_hash STREQUAL project_after)
        message(FATAL_ERROR "Editor rewrote the invalid project's startup selection")
    endif()
    if (failure STREQUAL "missing_file")
        if (EXISTS "${pipeline}")
            message(FATAL_ERROR "Editor silently recreated the missing pipeline")
        endif()
    else()
        file(SHA256 "${pipeline}" pipeline_after)
        if (NOT pipeline_hash STREQUAL pipeline_after)
            message(FATAL_ERROR "Editor rewrote the invalid pipeline")
        endif()
    endif()
    message(STATUS "Editor remained usable with ${failure}, including Native/Dock transitions")
endforeach()
