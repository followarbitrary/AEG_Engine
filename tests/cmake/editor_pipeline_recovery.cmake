cmake_minimum_required(VERSION 3.25)

if (NOT DEFINED EDITOR OR NOT DEFINED FIXTURE_WRITER OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "EDITOR, FIXTURE_WRITER and TEST_ROOT are required")
endif()
get_filename_component(test_root_absolute "${TEST_ROOT}" ABSOLUTE)
get_filename_component(test_root_name "${test_root_absolute}" NAME)
if (NOT test_root_name STREQUAL "editor-pipeline-recovery")
    message(FATAL_ERROR "Refusing to reset an unexpected fixture directory")
endif()
file(REMOVE_RECURSE "${test_root_absolute}")
file(MAKE_DIRECTORY "${test_root_absolute}")
set(ENV{APPDATA} "${test_root_absolute}")
execute_process(COMMAND "${FIXTURE_WRITER}" --startup-recovery-fixture "${test_root_absolute}"
    RESULT_VARIABLE fixture_result OUTPUT_VARIABLE fixture_output ERROR_VARIABLE fixture_error TIMEOUT 30)
if (NOT fixture_result EQUAL 0)
    message(FATAL_ERROR "Recovery fixture failed: ${fixture_output}\n${fixture_error}")
endif()

set(project "${test_root_absolute}/Project/Project.aegproj")
set(scene "${test_root_absolute}/Project/Assets/Scenes/Mesh.aegscene")
set(sidecar "${scene}.pipeline")
set(renamed "${test_root_absolute}/Project/Assets/Scenes/Removed.aegframe")
set(original_project_file "${test_root_absolute}/original-Project.aegproj")
file(SHA256 "${project}" original_project_hash)
# file(WRITE) converts LF to CRLF on Windows. Keep an untouched binary
# snapshot for every restoration; text writes below intentionally alter only
# the negative fixture input whose bytes are captured before Main reads it.
file(COPY_FILE "${project}" "${original_project_file}")
file(READ "${original_project_file}" original_project)
file(SHA256 "${scene}" scene_hash)

function(run_editor_case case diagnostic)
    if (diagnostic STREQUAL "")
        set(verification --expected-scene "${scene}")
        set(marker "FEATURE_PREVIEW_VERIFIED recovered")
    else()
        set(verification --expect-project-rejected)
        set(marker "FEATURE_PREVIEW_VERIFIED rejected")
    endif()
    execute_process(COMMAND "${EDITOR}" --project "${project}" --frames 60 --stress-native-viewports
        --verify-feature-preview ${verification}
        WORKING_DIRECTORY "${test_root_absolute}"
        RESULT_VARIABLE run_result OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error TIMEOUT 30)
    set(run_log "${run_output}\n${run_error}")
    file(WRITE "${test_root_absolute}/${case}.log" "${run_log}")
    if (NOT run_result EQUAL 0 OR run_log MATCHES "Application +ERROR|Application +FATAL" OR
        NOT run_log MATCHES "${marker}")
        message(FATAL_ERROR "Editor failed recovery for ${case}: ${run_log}")
    endif()
    if (NOT diagnostic STREQUAL "" AND (NOT run_log MATCHES "Application +WARNING" OR
        NOT run_log MATCHES "${diagnostic}"))
        message(FATAL_ERROR "Editor did not explicitly reject ${case}: ${run_log}")
    endif()
    if (diagnostic STREQUAL "" AND run_log MATCHES "Application +WARNING")
        message(FATAL_ERROR "Supported Feature recovery produced a warning: ${run_log}")
    endif()
    file(SHA256 "${scene}" scene_after)
    if (NOT scene_hash STREQUAL scene_after)
        message(FATAL_ERROR "Editor rewrote the real Scene during ${case}")
    endif()
    message(STATUS "Editor remained usable with ${case}, including Native/Dock transitions")
endfunction()

foreach(failure IN ITEMS retired_sidecar malformed_sidecar startup_pipelines startup_frame_projections renamed_payload)
    file(COPY_FILE "${original_project_file}" "${project}")
    if (failure STREQUAL "retired_sidecar")
        set(diagnostic "Retired Scene author sidecar is unsupported")
    elseif (failure STREQUAL "malformed_sidecar")
        # Retired files are rejected by presence, without probing their codec.
        file(WRITE "${sidecar}" "not a valid legacy record\n")
        set(diagnostic "Retired Scene author sidecar is unsupported")
    elseif (failure STREQUAL "renamed_payload")
        file(REMOVE "${sidecar}")
        # Real Scene bytes under a retired extension must not bypass the boundary.
        file(COPY_FILE "${scene}" "${renamed}")
        string(REGEX REPLACE "startup_scene = [^\n]*" "startup_scene = \"Assets/Scenes/Removed.aegframe\""
            changed_project "${original_project}")
        file(WRITE "${project}" "${changed_project}")
        file(SHA256 "${renamed}" renamed_hash)
        set(diagnostic "Retired Frame/Pipeline author documents cannot be opened as a Scene")
    else()
        string(REPLACE "[build]" "[build]\n${failure} = []" changed_project "${original_project}")
        file(WRITE "${project}" "${changed_project}")
        set(diagnostic "Removed project startup field: build.${failure}")
    endif()
    file(SHA256 "${project}" project_hash)
    if (EXISTS "${sidecar}")
        file(SHA256 "${sidecar}" sidecar_hash)
    endif()
    run_editor_case("${failure}" "${diagnostic}")
    file(SHA256 "${project}" project_after)
    if (NOT project_hash STREQUAL project_after)
        message(FATAL_ERROR "Editor restamped the rejected project during ${failure}")
    endif()
    if (EXISTS "${sidecar}")
        file(SHA256 "${sidecar}" sidecar_after)
        if (NOT sidecar_hash STREQUAL sidecar_after)
            message(FATAL_ERROR "Editor rewrote a retired sidecar during ${failure}")
        endif()
    elseif (NOT failure STREQUAL "renamed_payload")
        message(FATAL_ERROR "Editor removed the retired sidecar during ${failure}")
    endif()
    if (failure STREQUAL "renamed_payload")
        file(SHA256 "${renamed}" renamed_after)
        if (NOT renamed_hash STREQUAL renamed_after)
            message(FATAL_ERROR "Editor rewrote renamed payload bytes")
        endif()
    endif()
endforeach()

# Restore supported source input and prove recovery through the actual Feature
# Preview. Neither the retired file nor a replacement author sidecar is created.
file(COPY_FILE "${original_project_file}" "${project}")
run_editor_case("feature_recovery" "")
file(SHA256 "${project}" recovered_project_hash)
file(SHA256 "${original_project_file}" original_snapshot_hash)
if (NOT original_project_hash STREQUAL recovered_project_hash OR NOT original_project_hash STREQUAL original_snapshot_hash)
    message(FATAL_ERROR "Editor recovery changed the project bytes: expected ${original_project_hash}, got ${recovered_project_hash}")
endif()
if (EXISTS "${sidecar}")
    message(FATAL_ERROR "Editor recovery recreated a retired author sidecar")
endif()
